    },
    {
      "source": "/openclaw-ebook",
      "destination": "/openclaw-ebook.html"
    },
    {
      "source": "/openclaw-quickstart",
      "destination": "https://openclaw-guide-landing-page.vercel.app/sales-page.html"
    },
    {
      "source": "/oc-guidebook",
      "destination": "https://openclaw-guide-landing-page.vercel.app/"
    },
    {
      "source": "/leads",
      "destination": "/leads.html"
    }
  ]
}
